<script src="./generation-timeline_files/chapters.js.download"></script>
<script src="./generation-timeline_files/shared.js.download"></script>
<script>
var MCQA = {
  c1a1:"B",
  c1a2:"B",
  c1a3:"B",
  c1a4:"C",
  c1a5:"B",
  c1a6:"B",
  c1a7:"C",
  c1a8:"A",
  c1b1:"A",
  c1b2:"B",
  c1b3:"C",
  c1b4:"D",
  c1b5:"C",
  c1b6:"C",
  c1b7:"B",
};
var MCQE = {
  c1a1:"Blaise Pascal (French mathematician) invented the Pascaline in 1642 — a mechanical adding machine with gears that could add and subtract.",
  c1a2:"ENIAC (Electronic Numerical Integrator And Computer) was the first general-purpose electronic computer, completed in 1945 at the University of Pennsylvania.",
  c1a3:"The Abacus originated in China around 2400 BC. It uses beads on rods to perform arithmetic calculations.",
  c1a4:"Charles Babbage (1791–1871) designed the Difference Engine and Analytical Engine — mechanical computers that laid the foundation of modern computing.",
  c1a5:"Ada Lovelace wrote the first algorithm intended for Charles Babbage's Analytical Engine, making her the world's first computer programmer (1843).",
  c1a6:"Second generation computers (1956–1963) replaced vacuum tubes with transistors — smaller, faster, more reliable and energy-efficient.",
  c1a7:"UNIVAC-I (1951) was the first commercially produced computer sold to a business — the US Census Bureau. It marked the start of the commercial computer era.",
  c1a8:"ENIAC = Electronic Numerical Integrator And Computer. Built 1943–1945 at UPenn, it weighed 30 tons, filled an entire room and used 18,000 vacuum tubes.",
  c1b1:"Hybrid computers combine analog and digital components. Used in hospitals (ECG monitors) and industrial control systems where both continuous and discrete data are needed.",
  c1b2:"1st gen: Vacuum tubes → 2nd gen: Transistors → 3rd gen: Integrated Circuits (IC) → 4th gen: Very Large Scale Integration (VLSI) / Microprocessors.",
  c1b3:"Charles Babbage designed the Difference Engine in 1822 to compute mathematical tables. Though never fully built in his lifetime, it proved the concept of mechanical computation.",
  c1b4:"5th generation computers (present–future) use AI, machine learning, parallel processing and natural language processing. Japan's FGCS project pioneered this concept.",
  c1b5:"John Napier invented Napier's Bones in 1617 — a set of numbered rods that could rapidly perform multiplication and division calculations.",
  c1b6:"Tim Berners-Lee invented the World Wide Web in 1989 at CERN, Switzerland. He proposed it as a way to share information among researchers using hyperlinks.",
  c1b7:"First generation computers used punched cards and paper tape for input. Programs were entered by physically punching holes in cards that the machine could read.",
};

// ── Section navigation ──
document.addEventListener('click', function(e){
  var el = e.target;
  for(var i=0;i<8;i++){
    if(!el||el===document.body) break;
    if(el.dataset&&el.dataset.nav){
      document.querySelectorAll('.mnav').forEach(b=>b.classList.remove('on'));
      el.classList.add('on');
      document.querySelectorAll('.sec').forEach(s=>s.classList.remove('on'));
      var sec=document.getElementById('sec-'+el.dataset.nav);
      if(sec) sec.classList.add('on');
      updateExTotal(); return;
    }
    if(el.dataset&&el.dataset.ct){
      var fid=el.dataset.fid||el.dataset.ct;
      var container=el.closest('.card')||el.closest('.sim-box')||el.closest('.sec');
      if(container){
        container.querySelectorAll('.ctab').forEach(t=>t.classList.remove('on'));
        el.classList.add('on');
        container.querySelectorAll('.cpanel').forEach(p=>p.classList.remove('on'));
        var panel=container.querySelector('#'+fid);
        if(panel) panel.classList.add('on');
      }
      return;
    }
    if(el.dataset&&el.dataset.et){
      document.querySelectorAll('.ex-tab').forEach(t=>t.classList.remove('on'));
      el.classList.add('on');
      document.querySelectorAll('.ex-sec').forEach(s=>s.classList.remove('on'));
      var esec=document.getElementById('ex-'+el.dataset.et);
      if(esec){ esec.classList.add('on'); updateExTotal(); }
      return;
    }
    if(el.dataset&&el.dataset.dev){
      var grid=el.closest('.device-grid');
      if(grid) grid.querySelectorAll('.device-card').forEach(c=>c.classList.remove('on'));
      el.classList.add('on');
      document.querySelectorAll('.device-detail').forEach(d=>d.classList.remove('on'));
      var dd=document.getElementById('dd-'+el.dataset.dev);
      if(dd) dd.classList.add('on');
      return;
    }
    if(el.dataset&&el.dataset.mcq){doMCQ(el.dataset.mcq,el.dataset.c);return;}
    if(el.dataset&&el.dataset.reset){resetAll();return;}
    el=el.parentElement;
  }
});

// ── MCQ Engine ──
var score=0,answered=0;
function doMCQ(qid,chosen){
  var card=document.getElementById(qid);
  if(!card||card.dataset.done) return;
  card.dataset.done='1';
  var correct=MCQA[qid],letters=['A','B','C','D'];
  card.querySelectorAll('.opt').forEach((o,i)=>{
    if(letters[i]===chosen&&chosen===correct) o.classList.add('ok');
    else if(letters[i]===chosen) o.classList.add('ng');
    else if(letters[i]===correct) o.classList.add('ok');
    else o.classList.add('dim');
  });
  var fb=document.getElementById('fb-'+qid);
  if(fb){
    if(chosen===correct){fb.className='fb on ok';fb.innerHTML='✓ Correct! '+MCQE[qid];score++;}
    else{fb.className='fb on ng';fb.innerHTML='✗ Answer: <strong>'+correct+'</strong>. '+MCQE[qid];}
  }
  answered++; updScore();
}
function updScore(){
  var sn=document.getElementById('ex-score-num');
  var sa=document.getElementById('ex-score-ans');
  var pb=document.getElementById('ex-pbar');
  var tot=parseInt((document.getElementById('ex-total')||{}).textContent)||1;
  if(sn) sn.textContent=score;
  if(sa) sa.textContent=answered;
  if(pb) pb.style.width=(answered/tot*100)+'%';
}
function resetAll(){
  score=0;answered=0;
  document.querySelectorAll('.q-card').forEach(c=>delete c.dataset.done);
  document.querySelectorAll('.opt').forEach(o=>o.className='opt');
  document.querySelectorAll('.fb').forEach(f=>{f.className='fb';f.innerHTML='';});
  updScore(); updateExTotal();
}
function updateExTotal(){
  var vis=document.querySelector('.ex-sec.on');
  var el=document.getElementById('ex-total');
  if(el) el.textContent=vis?vis.querySelectorAll('.q-card').length:0;
}

// ── zoom.js fallback lightbox ──
(function(){
  var ov=null;
  function makeOv(){
    var o=document.createElement('div');
    o.style.cssText='position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.85);display:flex;align-items:center;justify-content:center;padding:24px;cursor:zoom-out;animation:fadeUp .2s ease';
    var img=document.createElement('img');
    img.style.cssText='max-width:min(90vw,900px);max-height:85vh;object-fit:contain;border-radius:8px;box-shadow:0 8px 48px rgba(0,0,0,.7)';
    o.appendChild(img);
    o.addEventListener('click',function(){document.body.removeChild(o);ov=null;document.body.style.overflow='';});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&ov){document.body.removeChild(ov);ov=null;document.body.style.overflow='';}});
    return {overlay:o,img:img};
  }
  document.addEventListener('click',function(e){
    var t=e.target;
    if(t.tagName==='IMG'&&(t.classList.contains('zoomable')||t.closest('.wiki-fig')||t.closest('.wiki-item'))){
      if(ov) return;
      var r=makeOv();
      r.img.src=t.src;r.img.alt=t.alt||'';
      ov=r.overlay;
      document.body.appendChild(ov);
      document.body.style.overflow='hidden';
    }
  });
})();


// Binary bit toggle
document.getElementById('bit-row')&&document.getElementById('bit-row').addEventListener('click',function(e){
  var bit=e.target.closest('.bit');
  if(!bit) return;
  bit.classList.toggle('on');
  bit.textContent=bit.classList.contains('on')?'1':'0';
  updateBits();
});
function updateBits(){
  var bits=document.querySelectorAll('.bit');
  var val=0;
  bits.forEach(function(b){
    if(b.classList.contains('on')) val+=Math.pow(2,parseInt(b.dataset.pos));
  });
  document.getElementById('bit-val').innerHTML='Decimal value: <span style="color:var(--brand)">'+val+'</span>';
  var info=document.getElementById('bin-info');
  if(info){
    var ascii=val>=32&&val<=126?String.fromCharCode(val):'—';
    info.textContent='Binary: '+Array.from(document.querySelectorAll('.bit')).map(b=>b.textContent).join('') + 
      ' = Decimal: '+val + (ascii!=='—'?' = ASCII character: "'+ascii+'"':'') +
      (val===0?' — All bits OFF (0)':val===255?' — All bits ON (maximum 8-bit value)':'');
  }
}
function setBits(n){
  document.querySelectorAll('.bit').forEach(function(b){
    var on=(n>>parseInt(b.dataset.pos))&1;
    b.classList.toggle('on',on===1);
    b.textContent=on===1?'1':'0';
  });
  updateBits();
}


/* ══ QnA toggle & controls ══ */
function qnaToggle(el){
  var card=el.closest('.qna-card');
  card.classList.toggle('open');
  qnaUpdCount();
}
function qnaMarkSwitch(btn,panelId){
  document.querySelectorAll('.qna-mark-btn').forEach(function(b){b.classList.remove('on');});
  btn.classList.add('on');
  document.querySelectorAll('.qna-mark-panel').forEach(function(p){p.classList.remove('on');});
  var panel=document.getElementById('qna-panel-'+panelId);
  if(panel) panel.classList.add('on');
  qnaUpdCount();
}
function qnaShowAll(){
  var panel=document.querySelector('.qna-mark-panel.on');
  if(panel) panel.querySelectorAll('.qna-card').forEach(function(c){c.classList.add('open');});
  qnaUpdCount();
}
function qnaHideAll(){
  var panel=document.querySelector('.qna-mark-panel.on');
  if(panel) panel.querySelectorAll('.qna-card').forEach(function(c){c.classList.remove('open');});
  qnaUpdCount();
}
function qnaUpdCount(){
  var panel=document.querySelector('.qna-mark-panel.on');
  var open=panel?panel.querySelectorAll('.qna-card.open').length:0;
  var el=document.getElementById('qna-open-count');
  if(el) el.textContent=open;
}

document.addEventListener('DOMContentLoaded',function(){
  updateExTotal(); updScore();
});

</script>
