<!DOCTYPE html>
<!-- saved from url=(0063)https://pragyapath.com/class7/computer/history-of-computer.html -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>History of Computer — Class 7 Computer Science | Pragyapath</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link href="./generation-timeline_files/css2" rel="stylesheet">
<link rel="stylesheet" href="./generation-timeline_files/shared.css">
<link rel="canonical" href="https://pragyapath.com/class7/computer/history-of-computer.html">
<style>

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --brand:#1e40af;--brand-l:rgba(30,64,175,0.10);--brand-d:#1e3a8a;
  --grn:#15803d;--grn-l:rgba(21,128,61,0.10);
  --amb:#b45309;--amb-l:rgba(180,83,9,0.10);
  --pur:#7c3aed;--pur-l:rgba(124,58,237,0.10);
  --red:#dc2626;--red-l:rgba(220,38,38,0.10);
  --teal:#0d9488;--teal-l:rgba(13,148,136,0.10);
  --r:8px;--r2:12px;--r3:16px;--r4:20px;
  --mono:'Space Mono',monospace;--sans:'Outfit',sans-serif;
  --shadow-sm:0 1px 4px rgba(0,0,0,.07);
  --shadow:0 4px 18px rgba(0,0,0,.10);
}
html{scroll-behavior:smooth}
body{font-family:var(--sans);font-size:15px;line-height:1.7;padding:0 0 64px}
.wrap{max-width:960px;margin:0 auto;padding:0 16px}

/* HEADER */
.hdr{border-radius:var(--r4);position:relative;overflow:hidden;margin-top:16px;padding:32px 28px 26px;color:#fff}
.hdr-grid{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;pointer-events:none}
.hdr-tag{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;opacity:.8;margin-bottom:6px;position:relative}
.hdr-title{font-size:clamp(22px,4vw,34px);font-weight:900;color:#fff;line-height:1.15;position:relative}
.hdr-title span{background:linear-gradient(135deg,#fbbf24,#34d399);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hdr-sub{font-size:13.5px;color:rgba(255,255,255,.72);margin-top:6px;position:relative}
.hdr-badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px;position:relative}
.badge{font-size:11px;padding:3px 11px;border-radius:20px;font-weight:600;background:rgba(255,255,255,.12);color:rgba(255,255,255,.85);border:1px solid rgba(255,255,255,.15)}
.badge.hi{background:rgba(251,191,36,.2);color:#fbbf24;border-color:rgba(251,191,36,.35)}

/* MAIN NAV */
.main-nav{display:flex;gap:3px;background:var(--bg2,#fff);border-radius:var(--r2);padding:5px;
  margin:14px 0 0;overflow-x:auto;border:1px solid var(--border,rgba(0,0,0,.1));scrollbar-width:none;
  position:sticky;top:60px;z-index:50;box-shadow:var(--shadow-sm)}
.main-nav::-webkit-scrollbar{display:none}
.mnav{flex:1;min-width:72px;padding:8px 6px;border-radius:var(--r);font-size:12px;font-weight:700;
  border:none;background:transparent;color:var(--text3,#888);cursor:pointer;transition:all .17s;
  text-align:center;white-space:nowrap;font-family:var(--sans)}
.mnav:hover{background:var(--bg3,#f4f4f4);color:var(--text,#111)}
.mnav.on{background:var(--brand);color:#fff;box-shadow:0 2px 10px rgba(30,64,175,.3)}
.sec{display:none;padding:16px 0 10px}.sec.on{display:block}

/* CARDS */
.card{background:var(--bg2,#fff);border:1px solid var(--border,rgba(0,0,0,.08));border-radius:var(--r3);
  padding:20px 22px;margin-bottom:14px;box-shadow:var(--shadow-sm)}
.card h2{font-size:18px;font-weight:800;margin-bottom:10px;display:flex;align-items:center;gap:9px;color:var(--text,#111)}
.card h3{font-size:14px;font-weight:700;margin:12px 0 6px;color:var(--text,#111)}
.card p,.card li{font-size:13.5px;color:var(--text2,#444);margin-bottom:5px;line-height:1.65}
.card ul,.card ol{padding-left:18px}

/* CALLOUTS */
.def{background:var(--brand-l);border-left:3px solid var(--brand);border-radius:0 var(--r) var(--r) 0;padding:11px 15px;margin:9px 0;font-size:13.5px;color:var(--brand-d)}
.eg{background:var(--grn-l);border-left:3px solid var(--grn);border-radius:0 var(--r) var(--r) 0;padding:11px 15px;margin:9px 0;font-size:13.5px;color:var(--grn)}
.note{background:var(--amb-l);border-left:3px solid var(--amb);border-radius:0 var(--r) var(--r) 0;padding:10px 14px;margin:8px 0;font-size:13px;color:var(--amb)}
.tip{background:var(--pur-l);border-left:3px solid var(--pur);border-radius:0 var(--r) var(--r) 0;padding:10px 14px;margin:8px 0;font-size:13px;color:var(--pur)}
.warn{background:var(--red-l);border-left:3px solid var(--red);border-radius:0 var(--r) var(--r) 0;padding:10px 14px;margin:8px 0;font-size:13px;color:var(--red)}

/* COMPARISON GRID */
.cmp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin:12px 0}
.cmp-box{border-radius:var(--r2);padding:14px;border:1.5px solid}
.cmp-box.blue{background:var(--brand-l);border-color:rgba(30,64,175,.25)}
.cmp-box.grn{background:var(--grn-l);border-color:rgba(21,128,61,.25)}
.cmp-box.red{background:var(--red-l);border-color:rgba(220,38,38,.25)}
.cmp-box.pur{background:var(--pur-l);border-color:rgba(124,58,237,.25)}
.cmp-box.amb{background:var(--amb-l);border-color:rgba(180,83,9,.25)}
.cmp-box.teal{background:var(--teal-l);border-color:rgba(13,148,136,.25)}
.cmp-tag{font-size:9px;font-family:var(--mono);text-transform:uppercase;letter-spacing:1.5px;font-weight:700;margin-bottom:5px;opacity:.75}
.cmp-box h3{font-size:13px;font-weight:800;margin-bottom:5px}
.cmp-box p{font-size:12.5px;line-height:1.6;margin:0}

/* TABLE */
.tbl{width:100%;border-collapse:collapse;font-size:13px;margin:10px 0;border-radius:var(--r);overflow:hidden}
.tbl th{text-align:left;padding:9px 12px;background:var(--bg3,#f4f4f4);color:var(--brand);font-weight:700;font-size:11px;font-family:var(--mono);text-transform:uppercase;letter-spacing:.07em;border-bottom:1.5px solid var(--border,rgba(0,0,0,.1))}
.tbl td{padding:8px 12px;border-bottom:.5px solid var(--border,rgba(0,0,0,.07));color:var(--text2,#444);font-size:13px;vertical-align:top}
.tbl tr:hover td{background:var(--bg3,#f4f4f4)}
.tbl tr:last-child td{border-bottom:none}

/* TABS */
.ctabs{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:10px}
.ctab{padding:5px 13px;border-radius:20px;font-size:12px;font-weight:700;border:1.5px solid var(--border,rgba(0,0,0,.1));background:transparent;color:var(--text3,#888);cursor:pointer;font-family:var(--sans);transition:all .15s}
.ctab:hover{border-color:var(--brand);color:var(--brand)}
.ctab.on{background:var(--brand);color:#fff;border-color:var(--brand)}
.cpanel{display:none}.cpanel.on{display:block}

/* FORMULA */
.fml{font-family:var(--mono);font-size:15px;font-weight:700;background:var(--bg3,#f4f4f4);border:1.5px solid var(--border,rgba(0,0,0,.1));border-radius:var(--r2);padding:14px 18px;margin:10px 0;text-align:center;letter-spacing:.05em}

/* TIMELINE */
.timeline{margin:14px 0;position:relative;padding-left:20px}
.timeline::before{content:'';position:absolute;left:8px;top:0;bottom:0;width:2px;background:var(--brand);opacity:.25;border-radius:2px}
.tl-item{position:relative;margin-bottom:20px;padding-left:24px}
.tl-item::before{content:'';position:absolute;left:-16px;top:6px;width:12px;height:12px;border-radius:50%;border:2.5px solid var(--brand);background:var(--bg2,#fff)}
.tl-year{font-family:var(--mono);font-size:11px;font-weight:700;color:var(--brand);margin-bottom:3px}
.tl-title{font-size:14px;font-weight:800;color:var(--text,#111);margin-bottom:3px}
.tl-desc{font-size:12.5px;color:var(--text2,#444);line-height:1.6}

/* DEVICE GRID */
.device-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;margin:12px 0}
.device-card{background:var(--bg3,#f4f4f4);border:1.5px solid var(--border,rgba(0,0,0,.08));border-radius:var(--r2);padding:14px;text-align:center;cursor:pointer;transition:all .2s}
.device-card:hover,.device-card.on{border-color:var(--brand);transform:translateY(-2px);box-shadow:var(--shadow)}
.device-card.on{background:var(--brand-l)}
.device-icon{font-size:30px;margin-bottom:6px}
.device-name{font-size:12px;font-weight:700;color:var(--text,#111)}
.device-detail{background:var(--bg2,#fff);border:1px solid var(--border,rgba(0,0,0,.08));border-radius:var(--r2);padding:16px;margin-top:10px;font-size:13.5px;color:var(--text2,#444);line-height:1.7;display:none}
.device-detail.on{display:block}

/* WIKI IMAGE */
.wiki-fig{margin:14px 0;border-radius:var(--r2);overflow:hidden;border:1px solid var(--border,rgba(0,0,0,.08))}
.wiki-fig img{width:100%;display:block;cursor:zoom-in;transition:opacity .2s}
.wiki-fig img:hover{opacity:.9}
.wiki-cap{font-size:11px;color:var(--text3,#888);font-family:var(--mono);padding:7px 10px;background:var(--bg3,#f4f4f4);line-height:1.5}
.wiki-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin:12px 0}
.wiki-item{border-radius:var(--r2);overflow:hidden;border:1px solid var(--border,rgba(0,0,0,.08))}
.wiki-item img{width:100%;height:140px;object-fit:cover;display:block;cursor:zoom-in;transition:opacity .2s}
.wiki-item img:hover{opacity:.9}
.wiki-item-cap{font-size:11px;color:var(--text3,#888);font-family:var(--mono);padding:6px 8px}

/* GENERATION / ERA CARDS */
.gen-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:10px;margin:12px 0}
.gen-card{border-radius:var(--r2);padding:16px;border:1.5px solid;position:relative;overflow:hidden}
.gen-num{position:absolute;top:10px;right:12px;font-family:var(--mono);font-size:28px;font-weight:900;opacity:.08;line-height:1}
.gen-era{font-size:9px;font-family:var(--mono);text-transform:uppercase;letter-spacing:1.5px;font-weight:700;margin-bottom:6px;opacity:.7}
.gen-title{font-size:13.5px;font-weight:800;margin-bottom:5px}
.gen-tech{font-size:11.5px;opacity:.8;line-height:1.5}

/* SIMULATION BOX */
.sim-box{background:var(--bg2,#fff);border:1px solid var(--border,rgba(0,0,0,.08));border-radius:var(--r3);padding:20px;margin:12px 0;box-shadow:var(--shadow-sm)}
.sim-title{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.15em;color:var(--brand);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.sim-title::after{content:'';flex:1;height:1px;background:var(--border,rgba(0,0,0,.1))}
.sim-screen{background:#0a0e1a;border-radius:var(--r);padding:16px;font-family:var(--mono);font-size:13px;color:#00d4ff;min-height:80px;margin:10px 0;border:1px solid rgba(0,212,255,.2)}
.btn-sim{padding:8px 20px;border-radius:var(--r);border:none;background:var(--brand);color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--sans);transition:all .15s;margin:4px}
.btn-sim:hover{opacity:.88;transform:translateY(-1px)}
.btn-sim.grn{background:var(--grn)}.btn-sim.red{background:var(--red)}.btn-sim.pur{background:var(--pur)}
.slider-row{display:flex;align-items:center;gap:10px;margin:8px 0}
.s-lbl{font-size:11px;font-weight:700;color:var(--text3,#888);min-width:90px;font-family:var(--mono)}
.s-val{font-size:12px;font-weight:700;color:var(--brand);min-width:60px;font-family:var(--mono)}
input[type=range]{flex:1;accent-color:var(--brand)}

/* HARDWARE COMPONENT DIAGRAM */
.hw-diagram{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0;max-width:500px}
.hw-block{border-radius:var(--r2);padding:12px;text-align:center;border:2px solid;font-size:12px;font-weight:700;position:relative}
.hw-cpu{background:#1e3a8a;border-color:#3b82f6;color:#fff;grid-column:2;grid-row:1}
.hw-ram{background:#065f46;border-color:#10b981;color:#fff}
.hw-storage{background:#7f1d1d;border-color:#ef4444;color:#fff}
.hw-io{background:#4c1d95;border-color:#8b5cf6;color:#fff}
.hw-mb{background:#92400e;border-color:#f59e0b;color:#fff;grid-column:1/-1}

/* ACTIVITY BLOCK */
.activity{background:linear-gradient(135deg,var(--grn-l),var(--brand-l));border:1.5px dashed var(--grn);border-radius:var(--r2);padding:16px;margin:14px 0}
.activity-hd{font-size:13px;font-weight:800;color:var(--grn);margin-bottom:6px;display:flex;align-items:center;gap:6px}
.activity p{font-size:13.5px;color:var(--text2,#444);line-height:1.65;margin:0}

/* EXERCISES */
.ex-score{display:flex;align-items:center;gap:14px;padding:11px 15px;background:var(--bg2,#fff);border:1px solid var(--border,rgba(0,0,0,.08));border-radius:var(--r2);margin-bottom:14px;box-shadow:var(--shadow-sm);position:sticky;top:110px;z-index:20}
.ex-snum{font-family:var(--mono);font-size:22px;font-weight:800;color:var(--brand)}
.ex-slbl{font-size:10px;color:var(--text3,#888);font-family:var(--mono);text-transform:uppercase}
.pbar-o{background:var(--bg3,#f4f4f4);border-radius:4px;height:5px;flex:1;overflow:hidden}
.pbar-i{height:100%;background:var(--brand);border-radius:4px;transition:width .4s}
.btn-rst{padding:5px 12px;background:transparent;color:var(--text3,#888);border:1.5px solid var(--border,rgba(0,0,0,.1));border-radius:var(--r);font-size:11px;font-weight:700;cursor:pointer;font-family:var(--sans)}
.ex-tabs{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:12px}
.ex-tab{padding:5px 13px;border-radius:20px;font-size:11px;font-weight:700;border:1.5px solid var(--border,rgba(0,0,0,.1));background:transparent;color:var(--text3,#888);cursor:pointer;font-family:var(--sans);transition:all .15s}
.ex-tab.on{background:var(--brand);color:#fff;border-color:var(--brand)}
.ex-sec{display:none}.ex-sec.on{display:block}
.q-card{background:var(--bg2,#fff);border:1.5px solid var(--border,rgba(0,0,0,.08));border-radius:var(--r2);margin-bottom:9px;overflow:hidden;box-shadow:var(--shadow-sm)}
.q-body{padding:13px 16px 0}
.q-text{font-size:13.5px;font-weight:600;color:var(--text,#111);line-height:1.65;margin-bottom:9px}
.q-pts{font-size:10px;color:var(--text3,#888);font-weight:400;font-family:var(--mono)}
.opts{display:flex;flex-direction:column;gap:5px;padding:0 16px 13px}
.opt{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:var(--r);font-size:13px;font-weight:600;border:1.5px solid var(--border,rgba(0,0,0,.1));background:var(--bg3,#f4f4f4);color:var(--text2,#444);cursor:pointer;text-align:left;transition:all .14s;font-family:var(--sans);width:100%}
.opt:hover{border-color:var(--brand);color:var(--text,#111)}
.opt.ok{background:var(--grn-l);border-color:var(--grn);color:var(--grn)}
.opt.ng{background:var(--red-l);border-color:var(--red);color:var(--red)}
.opt.dim{opacity:.3;pointer-events:none}
.opt-l{width:20px;height:20px;border-radius:4px;background:var(--bg3,#f4f4f4);color:var(--text3,#888);font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-family:var(--mono);transition:all .14s}
.opt.ok .opt-l{background:var(--grn);color:#fff}.opt.ng .opt-l{background:var(--red);color:#fff}
.fb{display:none;margin:0 16px 12px;padding:8px 12px;border-radius:var(--r);font-size:12.5px;font-weight:600;line-height:1.6}
.fb.on{display:block}
.fb.ok{background:var(--grn-l);color:var(--grn)}.fb.ng{background:var(--red-l);color:var(--red)}

/* SUMMARY GRID */
.sum-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin:12px 0}
.sum-box{background:var(--bg3,#f4f4f4);border-radius:var(--r2);padding:13px;border:1px solid var(--border,rgba(0,0,0,.08))}
.sum-term{font-size:13px;font-weight:800;color:var(--brand);margin-bottom:3px}
.sum-def{font-size:12px;color:var(--text2,#444);line-height:1.5}

/* STEP LIST */
.steps{margin:12px 0}
.step{display:flex;gap:12px;margin-bottom:10px;align-items:flex-start}
.step-n{flex-shrink:0;width:28px;height:28px;border-radius:50%;background:var(--brand);color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--mono);margin-top:2px}
.step-b{font-size:13.5px;color:var(--text2,#444);line-height:1.65}
.step-b strong{color:var(--text,#111)}

/* SOFTWARE TREE */
.sw-tree{margin:12px 0}
.sw-root{background:var(--brand);color:#fff;border-radius:var(--r2);padding:12px 16px;font-weight:800;font-size:14px;text-align:center;margin-bottom:8px}
.sw-children{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.sw-branch{border-radius:var(--r2);padding:12px;border:2px solid}
.sw-branch.sys{background:var(--brand-l);border-color:rgba(30,64,175,.3)}
.sw-branch.app{background:var(--grn-l);border-color:rgba(21,128,61,.3)}
.sw-branch h4{font-size:13px;font-weight:800;margin-bottom:6px}
.sw-branch ul{padding-left:16px;font-size:12.5px;color:var(--text2,#444)}
.sw-branch li{margin-bottom:3px}

/* BINARY DEMO */
.bit-row{display:flex;gap:4px;flex-wrap:wrap;margin:10px 0}
.bit{width:36px;height:36px;border-radius:var(--r);border:2px solid var(--border,rgba(0,0,0,.1));font-family:var(--mono);font-size:16px;font-weight:700;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;background:var(--bg3,#f4f4f4);color:var(--text3,#888)}
.bit.on{background:var(--brand);border-color:var(--brand);color:#fff;transform:scale(1.1)}
.bit-val{font-family:var(--mono);font-size:20px;font-weight:800;color:var(--brand);text-align:center;margin:8px 0}

/* CHART CANVAS */
canvas.chart{width:100%;max-height:200px;display:block}

@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.card{animation:fadeUp .2s ease}
@media(max-width:600px){.cmp-grid{grid-template-columns:1fr 1fr}.gen-grid{grid-template-columns:1fr 1fr}.hw-diagram{grid-template-columns:1fr 1fr}}
@media(max-width:420px){.cmp-grid,.gen-grid,.hw-diagram{grid-template-columns:1fr}}


/* ── QnA Section ─────────────────────────────────────────── */
.qna-controls{display:flex;align-items:center;justify-content:space-between;
  gap:10px;flex-wrap:wrap;background:var(--bg2,#fff);
  border:1.5px solid rgba(128,128,128,.18);border-radius:14px;
  padding:11px 16px;margin-bottom:18px;position:sticky;top:95px;z-index:20;
  box-shadow:0 1px 4px rgba(0,0,0,.07)}
.qna-ctrl-info{font-size:12px;color:var(--text2,#444);font-family:var(--mono,'Space Mono',monospace)}
.qna-ctrl-info strong{color:var(--text,#111)}
.qna-ctrl-btns{display:flex;gap:7px}
.qna-btn{padding:6px 16px;border-radius:8px;font-size:11px;font-weight:700;
  font-family:var(--sans,'Outfit',sans-serif);cursor:pointer;transition:all .14s;border:none}
.qna-btn-show{background:var(--brand,#1e40af);color:#fff}
.qna-btn-show:hover{opacity:.88}
.qna-btn-hide{background:transparent;color:var(--text2,#444);
  border:1.5px solid rgba(128,128,128,.25)}
.qna-btn-hide:hover{color:var(--text,#111)}

.qna-mark-nav{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
.qna-mark-btn{display:flex;align-items:center;gap:7px;padding:9px 20px;
  border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;
  border:2px solid transparent;background:var(--bg2,#fff);
  transition:all .16s;font-family:var(--sans,'Outfit',sans-serif);white-space:nowrap}
.qna-mark-btn .mb-pip{width:9px;height:9px;border-radius:50%;
  background:currentColor;opacity:.4;flex-shrink:0}
.qna-mark-btn.on .mb-pip{opacity:1}
.qna-mark-btn .mb-count{font-size:10px;font-family:var(--mono,'Space Mono',monospace);
  background:rgba(0,0,0,.08);padding:1px 7px;border-radius:10px}
.qna-mark-btn.on .mb-count{background:rgba(255,255,255,.25);color:#fff}
.qna-mark-btn[data-mark="1"]{color:#4a8fd4;border-color:rgba(74,143,212,.25)}
.qna-mark-btn[data-mark="1"].on{background:#4a8fd4;color:#fff;border-color:#4a8fd4}
.qna-mark-btn[data-mark="2"]{color:#e85d26;border-color:rgba(232,93,38,.25)}
.qna-mark-btn[data-mark="2"].on{background:#e85d26;color:#fff;border-color:#e85d26}
.qna-mark-btn[data-mark="4"]{color:#2db89a;border-color:rgba(45,184,154,.25)}
.qna-mark-btn[data-mark="4"].on{background:#2db89a;color:#fff;border-color:#2db89a}
.qna-mark-panel{display:none}.qna-mark-panel.on{display:block}

.qna-group-head{display:flex;align-items:center;gap:12px;
  margin:24px 0 12px;padding-bottom:10px;
  border-bottom:2px solid rgba(128,128,128,.12)}
.qna-group-icon{width:36px;height:36px;border-radius:9px;
  display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.gi-1m{background:rgba(74,143,212,.13)}
.gi-2m{background:rgba(232,93,38,.11)}
.gi-4m{background:rgba(45,184,154,.11)}
.qna-group-title{font-size:14px;font-weight:800;color:var(--text,#111)}
.qna-group-sub{font-size:11px;color:var(--text2,#444);margin-top:2px;font-style:italic}

.qna-card{background:var(--bg2,#fff);border:1.5px solid rgba(128,128,128,.18);
  border-radius:14px;margin-bottom:10px;overflow:hidden;
  transition:box-shadow .18s,transform .15s}
.qna-card:hover{box-shadow:0 4px 18px rgba(0,0,0,.10);transform:translateY(-1px)}
.qna-card.m1{border-left:4px solid #4a8fd4}
.qna-card.m2{border-left:4px solid #e85d26}
.qna-card.m4{border-left:4px solid #2db89a}

.qna-q{display:flex;align-items:flex-start;gap:12px;padding:14px 18px;
  cursor:pointer;user-select:none;transition:background .14s}
.qna-q:hover{background:rgba(0,0,0,.025)}
.qna-q-num{flex-shrink:0;width:26px;height:26px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:800;color:#fff;margin-top:2px;
  font-family:var(--mono,'Space Mono',monospace)}
.m1 .qna-q-num{background:#4a8fd4}
.m2 .qna-q-num{background:#e85d26}
.m4 .qna-q-num{background:#2db89a}
.qna-q-body{flex:1}
.qna-badge{display:inline-block;font-size:9px;font-weight:700;
  letter-spacing:1.5px;text-transform:uppercase;padding:2px 8px;
  border-radius:4px;margin-bottom:5px;font-family:var(--mono,'Space Mono',monospace)}
.m1 .qna-badge{background:rgba(74,143,212,.12);color:#4a8fd4}
.m2 .qna-badge{background:rgba(232,93,38,.10);color:#e85d26}
.m4 .qna-badge{background:rgba(45,184,154,.10);color:#2db89a}
.qna-q-en{font-size:13.5px;font-weight:600;color:var(--text,#111);
  line-height:1.6;display:block}
.qna-q-np{font-size:12px;color:var(--text2,#444);font-style:italic;
  margin-top:3px;line-height:1.5}
.qna-chevron{flex-shrink:0;width:26px;height:26px;border-radius:50%;
  border:1.5px solid rgba(128,128,128,.22);background:rgba(0,0,0,.03);
  display:flex;align-items:center;justify-content:center;
  font-size:11px;color:var(--text2,#444);transition:all .18s;margin-top:2px}
.qna-card.open .qna-chevron{transform:rotate(180deg);
  background:var(--brand,#1e40af);border-color:var(--brand,#1e40af);color:#fff}

.qna-a{display:none;padding:0 18px 16px;
  border-top:1px solid rgba(128,128,128,.10)}
.qna-card.open .qna-a{display:block}
.qna-a-inner{padding-top:14px;font-size:13px;color:var(--text2,#444);line-height:1.8}
.qna-a-inner p{margin-bottom:8px}.qna-a-inner p:last-child{margin-bottom:0}
.qna-a-inner strong{color:var(--text,#111)}
.qna-a-inner ul,.qna-a-inner ol{padding-left:20px;margin-bottom:8px}
.qna-a-inner li{margin-bottom:4px}
.qna-a-inner table{width:100%;border-collapse:collapse;font-size:12.5px;margin:8px 0}
.qna-a-inner th{text-align:left;padding:7px 10px;background:rgba(0,0,0,.04);
  font-weight:700;font-size:10px;text-transform:uppercase;
  letter-spacing:.07em;border-bottom:1.5px solid rgba(0,0,0,.08)}
.qna-a-inner td{padding:7px 10px;border-bottom:.5px solid rgba(0,0,0,.06);vertical-align:top}
.qna-a-inner tr:last-child td{border-bottom:none}

</style>
